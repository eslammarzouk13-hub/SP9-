<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TC24 | SP9 - قسم الفريمات</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root {
      --bg-main: #f8fafc;
      --card-bg: #ffffff;
      --accent-brown: #78350f;
      --accent-beige: #fef3c7;
      --accent-gold: #d97706;
      --accent-green: #059669;
      --accent-blue: #0284c7;
      --text-dark: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: var(--bg-main); color: var(--text-dark); padding: 20px; line-height: 1.6; }
    .welcome-banner {
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      border: 1px solid #fcd34d; color: #78350f;
      padding: 14px 22px; border-radius: 14px; margin-bottom: 20px;
      font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; gap: 12px;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.1);
    }
    header {
      background: linear-gradient(135deg, #78350f, #292524); color: white;
      padding: 26px 32px; border-radius: 20px; margin-bottom: 24px;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
      box-shadow: 0 10px 25px rgba(120, 53, 15, 0.25);
    }
    header h1 { font-size: 1.7rem; display: flex; align-items: center; gap: 12px; }
    header h1 i { color: #fde68a; }
    .nav-tabs {
      display: flex; gap: 10px; margin-bottom: 24px; background: #ffffff; padding: 10px;
      border-radius: 16px; border: 1px solid var(--border-color); overflow-x: auto;
    }
    .tab-btn {
      flex: 1; padding: 12px 14px; border: none; background: transparent; font-size: 0.9rem; font-weight: 700;
      color: var(--text-muted); cursor: pointer; border-radius: 12px; display: flex; justify-content: center; align-items: center; gap: 8px; white-space: nowrap;
    }
    .tab-btn.active { background: var(--accent-brown); color: white; box-shadow: 0 4px 12px rgba(120, 53, 15, 0.3); }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: var(--card-bg); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); border-right: 6px solid var(--accent-brown); }
    .stat-card.green { border-color: var(--accent-green); }
    .stat-card.gold { border-color: var(--accent-gold); }
    .stat-card.blue { border-color: var(--accent-blue); }
    .stat-title { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 600; }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: var(--accent-brown); }
    .grid-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 24px; }
    @media (max-width: 980px) { .grid-layout { grid-template-columns: 1fr; } }
    .card { background: var(--card-bg); padding: 26px; border-radius: 20px; border: 1px solid var(--border-color); margin-bottom: 24px; }
    .card h3 { margin-bottom: 18px; display: flex; align-items: center; gap: 10px; color: var(--accent-brown); font-size: 1.2rem; border-bottom: 2px solid #fef3c7; padding-bottom: 10px; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; margin-bottom: 6px; font-size: 0.9rem; font-weight: 700; }
    .form-control { width: 100%; padding: 12px 14px; background: #fdfdfd; border: 1px solid var(--border-color); border-radius: 12px; font-size: 0.95rem; outline: none; }
    .form-control:focus { border-color: var(--accent-brown); background: #fff; }
    .calc-box { background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; padding: 14px; margin-bottom: 14px; font-weight: 800; color: #78350f; }
    .calc-box div { display: flex; justify-content: space-between; margin-bottom: 6px; }
    .btn { width: 100%; padding: 13px; background: var(--accent-brown); color: white; border: none; border-radius: 12px; font-size: 1rem; font-weight: 800; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; }
    .btn-secondary { background: #fff; color: var(--accent-brown); border: 2px solid #fde68a; width: auto; padding: 10px 18px; border-radius: 10px; }
    .action-btns { display: flex; gap: 6px; }
    .btn-action { border: none; padding: 6px 10px; border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: bold; color: white; }
    .btn-edit { background: #d97706; }
    .btn-delete { background: #dc2626; }
    .btn-print-sm { background: #059669; }
    .btn-whatsapp { background: #25d366; }
    .status-badge { padding: 4px 10px; border-radius: 8px; font-size: 0.8rem; font-weight: bold; }
    .status-completed { background: #dcfce7; color: #166534; }
    .status-pending { background: #fef9c3; color: #854d0e; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { padding: 12px; text-align: right; border-bottom: 1px solid var(--border-color); font-size: 0.9rem; }
    th { background: #fef3c7; color: var(--accent-brown); font-weight: 800; }
    @media print {
      body { background: white !important; padding: 0; }
      header, .welcome-banner, .nav-tabs, .form-container, .btn, .no-print, .action-btns, .search-box-container { display: none !important; }
      .card { border: none; box-shadow: none; }
      th, td { border: 1px solid #ddd; }
    }
  </style>
</head>
<body>

  <div class="welcome-banner"><i class="fa-solid fa-hand"></i> أهلاً وسهلاً🤚</div>

  <header>
    <h1><i class="fa-solid fa-window-maximize"></i> TC24 - قسم الفريمات (SP9)</h1>
    <div style="display:flex; gap:10px;">
      <button class="btn btn-secondary" onclick="exportToExcel()"><i class="fa-solid fa-file-excel"></i> تصدير Excel</button>
      <button class="btn btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i> طباعة</button>
    </div>
  </header>

  <div class="nav-tabs">
    <button class="tab-btn active" onclick="switchTab('page-sales', this)"><i class="fa-solid fa-users"></i> تسجيل المبيعات</button>
    <button class="tab-btn" onclick="switchTab('page-search', this)"><i class="fa-solid fa-magnifying-glass"></i> البحث</button>
    <button class="tab-btn" onclick="switchTab('page-monthly', this)"><i class="fa-solid fa-file-invoice-dollar"></i> الحصر الشهري</button>
    <button class="tab-btn" onclick="switchTab('page-compare', this)"><i class="fa-solid fa-chart-column"></i> مقارنة الشهور</button>
    <button class="tab-btn" onclick="switchTab('page-settings', this)"><i class="fa-solid fa-desktop"></i> النسخ الاحتياطي</button>
  </div>

  <!-- صفحة 1 -->
  <div id="page-sales" class="tab-content active">
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-title">عدد العملاء اليوم</div><div class="stat-value" id="auto-day-count">0</div></div>
      <div class="stat-card green"><div class="stat-title">المحصل اليوم</div><div class="stat-value" id="auto-day-cash">0 ر.س</div></div>
      <div class="stat-card gold"><div class="stat-title">عدد العملاء هذا الشهر</div><div class="stat-value" id="auto-month-count">0</div></div>
      <div class="stat-card blue"><div class="stat-title">المحصل هذا الشهر</div><div class="stat-value" id="auto-month-cash">0 ر.س</div></div>
      <div class="stat-card"><div class="stat-title">المتبقي عند العملاء</div><div class="stat-value" id="auto-remaining">0 ر.س</div></div>
    </div>

    <div class="grid-layout">
      <div class="card form-container">
        <h3 id="formTitle"><i class="fa-solid fa-user-plus"></i> تسجيل عملية جديدة - SP9</h3>
        <form id="serviceForm">
          <input type="hidden" id="editIndex" value="-1">
          <div class="form-group"><label>تاريخ العملية</label><input type="date" id="serviceDate" class="form-control" required></div>
          <div class="form-group"><label>اسم العميل</label><input type="text" id="clientName" class="form-control" required placeholder="مثال: محمد العمري"></div>
          <div class="form-group"><label>رقم الجوال</label><input type="tel" id="clientPhone" class="form-control" required placeholder="05xxxxxxxx"></div>
          <div class="form-group"><label>كود العميل</label><input type="text" id="clientCode" class="form-control" required placeholder="مثال: SP9-1001"></div>

          <div class="form-group"><label>عدد فريم الشبك</label><input type="number" id="frameQty" class="form-control" value="0" min="0" oninput="calcTotal()"></div>
          <div class="form-group"><label>سعر فريم الشبك الواحد (ر.س)</label><input type="number" id="framePrice" class="form-control" value="0" min="0" oninput="calcTotal()"></div>
          <div class="form-group"><label>عدد البلاك أوت</label><input type="number" id="blackQty" class="form-control" value="0" min="0" oninput="calcTotal()"></div>
          <div class="form-group"><label>سعر البلاك أوت الواحد (ر.س)</label><input type="number" id="blackPrice" class="form-control" value="0" min="0" oninput="calcTotal()"></div>

          <div class="calc-box">
            <div><span>إجمالي المبلغ:</span><span id="calcTotal">0 ر.س</span></div>
            <div><span>الدفعة الأولى:</span><span id="calcPaid">0 ر.س</span></div>
            <div><span>المتبقي عند العميل:</span><span id="calcRemain">0 ر.س</span></div>
          </div>

          <div class="form-group"><label>الدفعة الأولى (ر.س)</label><input type="number" id="firstPay" class="form-control" value="0" min="0" oninput="calcTotal()"></div>
          <div class="form-group"><label>طريقة التحصيل</label><select id="payMethod" class="form-control"><option value="كاش / نقدي">كاش / نقدي</option><option value="شبكة">شبكة</option><option value="تحويل بنكي">تحويل بنكي</option></select></div>
          <button type="submit" class="btn" id="submitBtn"><i class="fa-solid fa-save"></i> حفظ البيانات</button>
        </form>
      </div>

      <div class="card">
        <h3><i class="fa-solid fa-address-book"></i> سجل العملاء والمبيعات</h3>
        <div style="overflow-x:auto;">
          <table>
            <thead><tr><th>الكود</th><th>التاريخ</th><th>العميل والجوال</th><th>الفريمات</th><th>الإجمالي / المدفوع / المتبقي</th><th>الحالة</th><th class="no-print">إجراءات</th></tr></thead>
            <tbody id="salesTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- صفحة 2 -->
  <div id="page-search" class="tab-content">
    <div class="card">
      <h3><i class="fa-solid fa-magnifying-glass"></i> البحث السريع</h3>
      <div class="search-box-container"><input type="text" id="searchInput" class="form-control" placeholder="ابحث بالاسم أو الكود أو الجوال..." oninput="filterData()"></div>
      <div style="overflow-x:auto;">
        <table>
          <thead><tr><th>الكود</th><th>العميل</th><th>الجوال</th><th>التاريخ</th><th>الإجمالي</th><th>المتبقي</th><th>الحالة</th><th class="no-print">واتساب</th></tr></thead>
          <tbody id="searchTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- صفحة 3 -->
  <div id="page-monthly" class="tab-content">
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:20px;">
        <h3><i class="fa-solid fa-file-invoice-dollar"></i> حصر مبيعات الشهر - SP9</h3>
        <div>
          <select id="selectMonth" class="form-control" style="display:inline-block; width:auto;" onchange="renderMonthlyReport()"></select>
          <button class="btn btn-secondary no-print" onclick="window.print()" style="display:inline-block; margin-right:10px;"><i class="fa-solid fa-print"></i> طباعة التقرير</button>
        </div>
      </div>
      <div id="monthlyReportArea">
        <div style="text-align:center; margin-bottom:20px;">
          <div style="font-size:2rem; font-weight:900; color:#78350f;">TC24</div>
          <div style="font-weight:800; color:#d97706;">قسم SP9 للفريمات</div>
        </div>
        <div style="overflow-x:auto;">
          <table>
            <thead><tr><th>الكود</th><th>التاريخ</th><th>اسم العميل</th><th>رقم الجوال</th><th>فريم شبك</th><th>بلاك أوت</th><th>المبلغ (ر.س)</th><th>المدفوع</th><th>المتبقي</th></tr></thead>
            <tbody id="monthlyTableBody"></tbody>
          </table>
        </div>
        <div style="margin-top:20px; background:#fef3c7; padding:15px; border-radius:12px; text-align:left; font-size:1.2rem; font-weight:bold; color:#78350f;">
          إجمالي الشهر: <span id="monthlyTotalSum">0</span> ر.س &nbsp; | &nbsp; المدفوع: <span id="monthlyPaidSum">0</span> ر.س &nbsp; | &nbsp; المتبقي: <span id="monthlyRemainSum">0</span> ر.س
        </div>
        <div style="margin-top:50px; border-top:2px solid #78350f; padding-top:15px; display:flex; justify-content:space-between; font-weight:bold; color:#78350f;">
          <div>مشرف القسم / مهندس عمر طه</div>
          <div>قسم الفريمات SP9</div>
        </div>
      </div>
    </div>
    <div class="card">
      <h3><i class="fa-solid fa-chart-column"></i> الرسم البياني لمبيعات كل شهر</h3>
      <div style="height:340px;"><canvas id="monthlyBarChart"></canvas></div>
    </div>
    <div class="card">
      <h3><i class="fa-solid fa-chart-pie"></i> تحصيل الدفعات في الشهر المختار</h3>
      <div style="height:320px; max-width:520px; margin:auto;"><canvas id="payDoughnutChart"></canvas></div>
      <p id="payChartSummary" style="text-align:center; font-weight:800; color:#78350f; margin-top:10px;"></p>
    </div>
  </div>

  <!-- صفحة 4 -->
  <div id="page-compare" class="tab-content">
    <div class="card">
      <h3><i class="fa-solid fa-chart-column"></i> مقارنة المبيعات بين الشهور</h3>
      <div style="height:380px;"><canvas id="compareChart"></canvas></div>
      <div style="overflow-x:auto; margin-top:20px;">
        <table><thead><tr><th>الشهر</th><th>عدد العملاء</th><th>إجمالي المبيعات</th><th>المدفوع</th><th>المتبقي</th></tr></thead><tbody id="compareTableBody"></tbody></table>
      </div>
    </div>
  </div>

  <!-- صفحة 5 -->
  <div id="page-settings" class="tab-content">
    <div class="card" style="max-width:700px; margin:0 auto;">
      <h3><i class="fa-solid fa-database"></i> النسخ الاحتياطي</h3>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <button class="btn" style="background:#0284c7; width:auto;" onclick="backupData()"><i class="fa-solid fa-download"></i> تصدير النسخة (JSON)</button>
        <label class="btn btn-secondary" style="cursor:pointer; margin:0;"><i class="fa-solid fa-upload"></i> استعادة النسخة <input type="file" accept=".json" style="display:none;" onchange="restoreData(event)"></label>
      </div>
      <p style="margin-top:16px; color:#64748b; font-size:0.9rem;">البيانات محفوظة على نفس الجهاز، والنسخة الاحتياطية تنقلها لأي جهاز تاني.</p>
    </div>
  </div>

  <script>
    let salesData = JSON.parse(localStorage.getItem('tc24_sp9_sales')) || [];
    document.getElementById('serviceDate').valueAsDate = new Date();
    calcTotal();

    function calcTotal() {
      let fq = Number(document.getElementById('frameQty').value) || 0;
      let fp = Number(document.getElementById('framePrice').value) || 0;
      let bq = Number(document.getElementById('blackQty').value) || 0;
      let bp = Number(document.getElementById('blackPrice').value) || 0;
      let paid = Number(document.getElementById('firstPay').value) || 0;
      let total = (fq * fp) + (bq * bp);
      let remain = total - paid;
      if (remain < 0) remain = 0;
      document.getElementById('calcTotal').innerText = total.toLocaleString() + ' ر.س';
      document.getElementById('calcPaid').innerText = paid.toLocaleString() + ' ر.س';
      document.getElementById('calcRemain').innerText = remain.toLocaleString() + ' ر.س';
    }

    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(tabId).classList.add('active');
      if (tabId === 'page-search') filterData();
      if (tabId === 'page-monthly') initMonthlyDropdown();
      if (tabId === 'page-compare') renderCompare();
    }

    function getStatus(s) {
      return (Number(s.remain) <= 0) ? 'مكتمل' : 'متبقي دفعات';
    }

    function updateAutoCounters() {
      const todayStr = new Date().toISOString().slice(0, 10);
      const currentMonthStr = todayStr.slice(0, 7);
      let dayCount = 0, dayCash = 0, monthCount = 0, monthCash = 0, totalRemain = 0;
      salesData.forEach(s => {
        totalRemain += Number(s.remain) || 0;
        if (s.date === todayStr) { dayCount++; dayCash += Number(s.paid) || 0; }
        if (s.date && s.date.startsWith(currentMonthStr)) { monthCount++; monthCash += Number(s.paid) || 0; }
      });
      document.getElementById('auto-day-count').innerText = dayCount;
      document.getElementById('auto-day-cash').innerText = dayCash.toLocaleString() + ' ر.س';
      document.getElementById('auto-month-count').innerText = monthCount;
      document.getElementById('auto-month-cash').innerText = monthCash.toLocaleString() + ' ر.س';
      document.getElementById('auto-remaining').innerText = totalRemain.toLocaleString() + ' ر.س';
    }

    function renderSales() {
      const table = document.getElementById('salesTableBody');
      table.innerHTML = '';
      salesData.forEach((s, index) => {
        let status = getStatus(s);
        let statusClass = status === 'مكتمل' ? 'status-completed' : 'status-pending';
        table.innerHTML += `
          <tr>
            <td><strong style="color: var(--accent-brown);">${s.code}</strong></td>
            <td>${s.date}</td>
            <td><strong>${s.client}</strong><br><small style="color:var(--text-muted);">${s.phone || '-'}</small></td>
            <td>شبك: ${s.frameQty} × ${Number(s.framePrice).toLocaleString()}<br>بلاك أوت: ${s.blackQty} × ${Number(s.blackPrice).toLocaleString()}</td>
            <td><strong>${Number(s.total).toLocaleString()} ر.س</strong><br>مدفوع: ${Number(s.paid).toLocaleString()} | متبقي: ${Number(s.remain).toLocaleString()}</td>
            <td><span class="status-badge ${statusClass}">${status}</span><br><small>${s.payMethod}</small></td>
            <td class="no-print">
              <div class="action-btns">
                <button class="btn-action btn-print-sm" onclick="printInvoice(${index})"><i class="fa-solid fa-print"></i></button>
                <button class="btn-action btn-whatsapp" onclick="sendWhatsapp(${index})"><i class="fa-brands fa-whatsapp"></i></button>
                <button class="btn-action btn-edit" onclick="editSale(${index})"><i class="fa-solid fa-pen"></i></button>
                <button class="btn-action btn-delete" onclick="deleteSale(${index})"><i class="fa-solid fa-trash"></i></button>
              </div>
            </td>
          </tr>
        `;
      });
      updateAutoCounters();
      localStorage.setItem('tc24_sp9_sales', JSON.stringify(salesData));
    }

    document.getElementById('serviceForm').onsubmit = (e) => {
      e.preventDefault();
      let fq = Number(document.getElementById('frameQty').value) || 0;
      let fp = Number(document.getElementById('framePrice').value) || 0;
      let bq = Number(document.getElementById('blackQty').value) || 0;
      let bp = Number(document.getElementById('blackPrice').value) || 0;
      let paid = Number(document.getElementById('firstPay').value) || 0;
      let total = (fq * fp) + (bq * bp);
      let remain = total - paid;
      if (remain < 0) remain = 0;
      if (total <= 0) { alert('دخل عدد وسعر واحد على الأقل.'); return; }
      const editIdx = parseInt(document.getElementById('editIndex').value);
      const dataObj = {
        code: document.getElementById('clientCode').value,
        client: document.getElementById('clientName').value,
        phone: document.getElementById('clientPhone').value,
        date: document.getElementById('serviceDate').value,
        frameQty: fq, framePrice: fp, blackQty: bq, blackPrice: bp,
        total: total, paid: paid, remain: remain,
        payMethod: document.getElementById('payMethod').value
      };
      if (editIdx > -1) {
        salesData[editIdx] = dataObj;
        document.getElementById('editIndex').value = "-1";
        document.getElementById('submitBtn').innerHTML = '<i class="fa-solid fa-save"></i> حفظ البيانات';
        document.getElementById('formTitle').innerHTML = '<i class="fa-solid fa-user-plus"></i> تسجيل عملية جديدة - SP9';
      } else { salesData.unshift(dataObj); }
      document.getElementById('serviceForm').reset();
      document.getElementById('serviceDate').valueAsDate = new Date();
      calcTotal();
      renderSales();
    };

    function editSale(index) {
      const s = salesData[index];
      document.getElementById('clientCode').value = s.code;
      document.getElementById('clientName').value = s.client;
      document.getElementById('clientPhone').value = s.phone || '';
      document.getElementById('serviceDate').value = s.date;
      document.getElementById('frameQty').value = s.frameQty;
      document.getElementById('framePrice').value = s.framePrice;
      document.getElementById('blackQty').value = s.blackQty;
      document.getElementById('blackPrice').value = s.blackPrice;
      document.getElementById('firstPay').value = s.paid;
      document.getElementById('payMethod').value = s.payMethod || 'كاش / نقدي';
      document.getElementById('editIndex').value = index;
      document.getElementById('submitBtn').innerHTML = '<i class="fa-solid fa-check-double"></i> تحديث بيانات العميل';
      document.getElementById('formTitle').innerHTML = '<i class="fa-solid fa-user-pen"></i> تعديل بيانات العميل';
      calcTotal();
      switchTab('page-sales', document.querySelectorAll('.tab-btn')[0]);
    }

    function deleteSale(index) {
      if (confirm('هل أنت متأكد من حذف بيانات هذا العميل؟')) { salesData.splice(index, 1); renderSales(); }
    }

    function sendWhatsapp(index) {
      const s = salesData[index];
      const phoneClean = (s.phone || '').replace(/[^0-9]/g, '');
      const msg = `مرحباً بك يا ${s.client} 👋%0Aفاتورة TC24 - قسم SP9 للفريمات:%0A- الكود: ${s.code}%0A- التاريخ: ${s.date}%0A- الإجمالي: ${Number(s.total).toLocaleString()} ريال%0A- المدفوع: ${Number(s.paid).toLocaleString()} ريال%0A- المتبقي: ${Number(s.remain).toLocaleString()} ريال`;
      window.open(`https://wa.me/${phoneClean}?text=${msg}`, '_blank');
    }

    function filterData() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const filtered = salesData.filter(s => s.client.toLowerCase().includes(query) || s.code.toLowerCase().includes(query) || (s.phone && s.phone.includes(query)));
      const table = document.getElementById('searchTableBody');
      table.innerHTML = '';
      filtered.forEach((s) => {
        const origIndex = salesData.indexOf(s);
        table.innerHTML += `<tr><td><strong>${s.code}</strong></td><td>${s.client}</td><td>${s.phone || '-'}</td><td>${s.date}</td><td>${Number(s.total).toLocaleString()} ر.س</td><td>${Number(s.remain).toLocaleString()} ر.س</td><td>${getStatus(s)}</td><td><button class="btn-action btn-whatsapp" onclick="sendWhatsapp(${origIndex})"><i class="fa-brands fa-whatsapp"></i> واتساب</button></td></tr>`;
      });
    }

    function initMonthlyDropdown() {
      const select = document.getElementById('selectMonth');
      const monthsSet = new Set();
      salesData.forEach(s => { if (s.date) monthsSet.add(s.date.slice(0, 7)); });
      select.innerHTML = '';
      const monthsArr = Array.from(monthsSet).sort().reverse();
      if (monthsArr.length === 0) { select.innerHTML = '<option value="">لا توجد شهور مسجلة</option>'; }
      else { monthsArr.forEach(m => { select.innerHTML += `<option value="${m}">شهر: ${m}</option>`; }); }
      renderMonthlyReport();
    }

    function renderMonthlyReport() {
      const selectedMonth = document.getElementById('selectMonth').value;
      const table = document.getElementById('monthlyTableBody');
      table.innerHTML = '';
      let totalSum = 0, paidSum = 0, remainSum = 0;
      salesData.forEach(s => {
        if (s.date && s.date.startsWith(selectedMonth)) {
          totalSum += Number(s.total); paidSum += Number(s.paid); remainSum += Number(s.remain);
          table.innerHTML += `<tr><td><strong>${s.code}</strong></td><td>${s.date}</td><td>${s.client}</td><td>${s.phone || '-'}</td><td>${s.frameQty}</td><td>${s.blackQty}</td><td><strong>${Number(s.total).toLocaleString()}</strong></td><td>${Number(s.paid).toLocaleString()}</td><td>${Number(s.remain).toLocaleString()}</td></tr>`;
        }
      });
      if (table.innerHTML === '') { table.innerHTML = '<tr><td colspan="9" style="text-align:center; color:var(--text-muted);">لا توجد عمليات مسجلة لهذا الشهر.</td></tr>'; }
      document.getElementById('monthlyTotalSum').innerText = totalSum.toLocaleString();
      document.getElementById('monthlyPaidSum').innerText = paidSum.toLocaleString();
      document.getElementById('monthlyRemainSum').innerText = remainSum.toLocaleString();
      renderCharts(selectedMonth);
    }

    let monthlyBarChart = null, payDoughnutChart = null, compareChart = null;
    function renderCharts(selectedMonth) {
      let months = {};
      salesData.forEach(function(s){ if(!s.date) return; let m = s.date.slice(0, 7); months[m] = (months[m] || 0) + (Number(s.total) || 0); });
      let labels = Object.keys(months).sort();
      let data = labels.map(function(l){ return months[l]; });
      let barEl = document.getElementById('monthlyBarChart');
      if(barEl){
        if(monthlyBarChart) monthlyBarChart.destroy();
        monthlyBarChart = new Chart(barEl, { type: 'bar', data: { labels: labels, datasets: [{ label: 'مبيعات الشهور (ر.س)', data: data, backgroundColor: '#78350f', borderRadius: 8 }] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } } });
      }
      let paid = 0, remain = 0;
      salesData.forEach(function(s){
        if(selectedMonth && s.date && !s.date.startsWith(selectedMonth)) return;
        paid += Number(s.paid) || 0; remain += Number(s.remain) || 0;
      });
      let sumEl = document.getElementById('payChartSummary');
      if(sumEl) sumEl.innerText = 'مكتمل التحصيل: ' + paid.toLocaleString() + ' ر.س | متبقي الدفعات: ' + remain.toLocaleString() + ' ر.س';
      let payEl = document.getElementById('payDoughnutChart');
      if(payEl){
        if(payDoughnutChart) payDoughnutChart.destroy();
        payDoughnutChart = new Chart(payEl, { type: 'doughnut', data: { labels: ['مدفوع', 'متبقي'], datasets: [{ data: [paid, remain], backgroundColor: ['#059669', '#d97706'] }] }, options: { responsive: true, maintainAspectRatio: false } });
      }
    }

    function renderCompare() {
      let months = {};
      salesData.forEach(function(s){
        if(!s.date) return; let m = s.date.slice(0, 7);
        if(!months[m]) months[m] = { count: 0, total: 0, paid: 0, remain: 0 };
        months[m].count++; months[m].total += Number(s.total) || 0; months[m].paid += Number(s.paid) || 0; months[m].remain += Number(s.remain) || 0;
      });
      let labels = Object.keys(months).sort();
      let table = document.getElementById('compareTableBody');
      table.innerHTML = '';
      labels.forEach(function(l){
        table.innerHTML += `<tr><td><strong>${l}</strong></td><td>${months[l].count}</td><td>${months[l].total.toLocaleString()} ر.س</td><td>${months[l].paid.toLocaleString()} ر.س</td><td>${months[l].remain.toLocaleString()} ر.س</td></tr>`;
      });
      let el = document.getElementById('compareChart');
      if(el){
        if(compareChart) compareChart.destroy();
        compareChart = new Chart(el, { type: 'bar', data: { labels: labels, datasets: [
          { label: 'إجمالي المبيعات', data: labels.map(l => months[l].total), backgroundColor: '#78350f', borderRadius: 8 },
          { label: 'المدفوع', data: labels.map(l => months[l].paid), backgroundColor: '#059669', borderRadius: 8 },
          { label: 'المتبقي', data: labels.map(l => months[l].remain), backgroundColor: '#d97706', borderRadius: 8 }
        ]}, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } } });
      }
    }

    function exportToExcel() {
      if (salesData.length === 0) { alert('لا توجد بيانات للتصدير!'); return; }
      let csv = '\uFEFFكود العميل,اسم العميل,رقم الجوال,التاريخ,عدد فريم الشبك,سعر الشبك,عدد البلاك اوت,سعر البلاك اوت,الاجمالي,المدفوع,المتبقي,الحالة,طريقة الدفع\n';
      salesData.forEach(s => {
        csv += `"${s.code}","${s.client}","${s.phone || ''}","${s.date}","${s.frameQty}","${s.framePrice}","${s.blackQty}","${s.blackPrice}","${s.total}","${s.paid}","${s.remain}","${getStatus(s)}","${s.payMethod}"\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `حصر_مبيعات_SP9_${new Date().toISOString().slice(0,10)}.csv`;
      link.click();
    }

    function backupData() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(salesData));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `TC24_SP9_Backup_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function restoreData(event) {
      const fileReader = new FileReader();
      fileReader.onload = function () {
        try {
          const parsed = JSON.parse(fileReader.result);
          if (Array.isArray(parsed)) { salesData = parsed; renderSales(); alert('تم استعادة النسخة بنجاح!'); }
        } catch (e) { alert('ملف غير صالح!'); }
      };
      fileReader.readAsText(event.target.files[0]);
    }

    function printInvoice(index) {
      const s = salesData[index];
      const printHtml = `
        <!DOCTYPE html>
        <html lang="ar" dir="rtl">
        <head><meta charset="UTF-8"><title>فاتورة - ${s.code}</title>
        <style>
          body { font-family: Tahoma, sans-serif; padding: 30px; background: #fff; direction: rtl; }
          .card { max-width: 600px; margin: 0 auto; border: 2px solid #78350f; border-radius: 12px; padding: 25px; }
          .header { text-align: center; border-bottom: 2px solid #fef3c7; padding-bottom: 12px; margin-bottom: 20px; }
          .header h2 { color: #78350f; margin-bottom: 4px; font-size: 2rem; }
          .row { display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px dashed #eee; padding-bottom: 6px; }
          .label { font-weight: bold; color: #4b5563; }
          .total { background: #fef3c7; padding: 12px; border-radius: 8px; text-align: center; font-size: 1.3rem; font-weight: bold; color: #78350f; margin-top: 20px; }
          .footer-sign { margin-top: 40px; border-top: 2px solid #78350f; padding-top: 15px; display: flex; justify-content: space-between; font-weight: bold; color: #78350f; }
        </style></head>
        <body>
          <div class="card">
            <div class="header"><h2>TC24</h2><p>قسم SP9 للفريمات</p></div>
            <div class="row"><span class="label">كود العميل:</span><span>${s.code}</span></div>
            <div class="row"><span class="label">اسم العميل:</span><span>${s.client}</span></div>
            <div class="row"><span class="label">رقم الجوال:</span><span>${s.phone || '-'}</span></div>
            <div class="row"><span class="label">التاريخ:</span><span>${s.date}</span></div>
            <div class="row"><span class="label">فريم شبك:</span><span>${s.frameQty} × ${Number(s.framePrice).toLocaleString()} ر.س</span></div>
            <div class="row"><span class="label">بلاك أوت:</span><span>${s.blackQty} × ${Number(s.blackPrice).toLocaleString()} ر.س</span></div>
            <div class="row"><span class="label">المدفوع:</span><span>${Number(s.paid).toLocaleString()} ر.س</span></div>
            <div class="row"><span class="label">المتبقي:</span><span>${Number(s.remain).toLocaleString()} ر.س</span></div>
            <div class="total">الإجمالي: ${Number(s.total).toLocaleString()} ريال سعودي</div>
            <div class="footer-sign"><div>مشرف القسم / مهندس عمر طه</div><div>قسم الفريمات SP9</div></div>
          </div>
        </body></html>
      `;
      const w = window.open('', '_blank', 'height=600,width=750');
      if (w) { w.document.write(printHtml); w.document.close(); w.focus(); setTimeout(() => { w.print(); w.close(); }, 300); }
    }

    renderSales();
  </script>
</body>
</html>
